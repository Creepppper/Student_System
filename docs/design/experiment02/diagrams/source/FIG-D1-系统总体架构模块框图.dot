digraph D1 {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.3, ranksep=0.35, pad=0.18,
         bgcolor="#FFFFFF", fontname="SimHei", fontsize=21, labelloc="t", label="FIG-D1  系统总体架构模块框图"];
  node [shape=box, style="rounded,filled", fontname="SimHei", fontsize=21, margin="0.12,0.08", penwidth=1.3];
  edge [fontname="SimHei", fontsize=14, arrowsize=0.7, penwidth=1.1, color="#52616B"];

  user [label="浏览器用户\n系统管理员 / 教务\n班主任 / 学生", fillcolor="#F4F7FA", color="#7A8FA6"];
  front [label="Vue3 SPA\nRouter / 页面 / Pinia / Axios", fillcolor="#DCEEFF", color="#2F6FED"];
  sec [label="Spring Security + JWT\n认证 / 功能权限 / 数据范围\nSpringdoc 旁路", fillcolor="#DCEEFF", color="#2F6FED"];
  base [label="若依基础能力（A）\nController / Service / Mapper\n用户·角色·菜单·日志·工具", fillcolor="#DCEEFF", color="#2F6FED"];
  biz [label="学生业务（C 规划）\nController / Service / Mapper\n组织·学生·考试·成绩·发布", fillcolor="#FFE7CF", color="#D97706", style="rounded,filled,dashed"];
  db [label="MariaDB 11.8\nstudent_system\n31 张：18 sys + 2 gen\n+ 11 QRTZ（实测）", fillcolor="#DFF3E4", color="#2E7D32"];
  valkey [label="Valkey 9\n验证码 / LoginUser / 缓存", fillcolor="#DFF3E4", color="#2E7D32"];

  user -> front [label="本地 HTTP / 可选 HTTPS"];
  front -> sec [label="Bearer JWT"];
  sec -> base [label="现有权限"];
  sec -> biz [label="规划权限", style=dashed, color="#D97706"];
  sec -> valkey [label="登录态"];
  base -> db [label="系统表"];
  biz -> db [label="业务表（规划）", style=dashed, color="#D97706"];
  { rank=same; db; valkey; }
}
