digraph D2 {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.45, ranksep=0.5, pad=0.25,
         bgcolor="#FFFFFF", fontname="SimHei", fontsize=14, labelloc="t",
         label="FIG-D2  后端 Maven 模块依赖图（实线=现有；橙色虚线=规划）"];
  node [shape=box, style="rounded,filled", fontname="SimHei", fontsize=13, margin="0.16,0.10", penwidth=1.3];
  edge [fontname="SimHei", fontsize=11, arrowsize=0.7, penwidth=1.1, color="#52616B"];

  admin [label="ruoyi-admin\n启动 / Web Controller\n(规划 Controller 放该模块)", fillcolor="#DCEEFF", color="#2F6FED"];
  framework [label="ruoyi-framework\nSecurity / JWT / Druid\nRedis / MyBatis / AOP", fillcolor="#DCEEFF", color="#2F6FED"];
  system [label="ruoyi-system\n用户 / 角色 / 菜单\n部门 / 字典 / 参数", fillcolor="#DCEEFF", color="#2F6FED"];
  common [label="ruoyi-common\n统一响应 / 异常 / 工具\n注解 / Redis 封装", fillcolor="#DCEEFF", color="#2F6FED"];
  quartz [label="ruoyi-quartz\nQuartz 任务与日志", fillcolor="#DCEEFF", color="#2F6FED"];
  generator [label="ruoyi-generator\n表导入 / Velocity", fillcolor="#DCEEFF", color="#2F6FED"];
  student [label="ruoyi-student（建议新增，待评审）\ndomain / service / mapper / resources\n不计入当前 6 模块", fillcolor="#FFE7CF", color="#D97706", style="rounded,filled,dashed"];

  admin -> framework [label="depends"];
  admin -> quartz [label="depends"];
  admin -> generator [label="depends"];
  framework -> system [label="depends"];
  system -> common [label="depends"];
  quartz -> common [label="depends"];
  generator -> common [label="depends"];

  admin -> student [label="规划 depends", style=dashed, color="#D97706"];
  student -> common [label="规划复用", style=dashed, color="#D97706"];
  student -> system [label="规划复用类型", style=dashed, color="#D97706"];

  { rank=same; framework; quartz; generator; }
  { rank=same; system; student; }
  { rank=same; common; }
}
