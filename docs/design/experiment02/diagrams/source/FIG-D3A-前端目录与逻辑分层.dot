digraph D3A {
  graph [rankdir=LR, newrank=true, splines=polyline, nodesep=0.45, ranksep=0.55, pad=0.25,
         bgcolor="#FFFFFF", fontname="SimHei", fontsize=14, labelloc="t",
         label="FIG-D3A  前端目录与逻辑分层（A 现状；橙色虚线=规划业务）"];
  node [shape=box, style="rounded,filled", fontname="SimHei", fontsize=13, margin="0.16,0.08", penwidth=1.2];
  edge [fontname="SimHei", fontsize=11, arrowsize=0.7, penwidth=1.1, color="#52616B"];

  browser [label="浏览器\nVue3 SPA", fillcolor="#F4F7FA", color="#7A8FA6"];
  router [label="src/router\n固定路由 + dynamicRoutes\n路由守卫", fillcolor="#DCEEFF", color="#2F6FED"];
  views [label="src/views\nsystem / monitor / tool\nLayout 页面", fillcolor="#DCEEFF", color="#2F6FED"];
  api [label="src/api\nsystem / monitor / tool\n按功能封装", fillcolor="#DCEEFF", color="#2F6FED"];
  axios [label="src/utils/request.js\nAxios 实例\nBearer Token/错误处理", fillcolor="#DCEEFF", color="#2F6FED"];
  pinia [label="src/store/modules\nuser / permission / 其他", fillcolor="#DCEEFF", color="#2F6FED"];
  proxy [label="Vite 6 开发代理\n/dev-api → :8080", fillcolor="#E8F0FF", color="#2F6FED", style="rounded,filled,dashed"];
  bizViews [label="src/views/business（规划）\n业务页面", fillcolor="#FFE7CF", color="#D97706", style="rounded,filled,dashed"];
  bizApi [label="src/api/business（规划）\n业务 API", fillcolor="#FFE7CF", color="#D97706", style="rounded,filled,dashed"];
  menu [label="后端 sys_menu\n动态菜单/按钮权限", fillcolor="#DCEEFF", color="#2F6FED"];

  browser -> router [label="访问"];
  router -> views [label="加载组件"];
  views -> api [label="调用 API"];
  api -> axios [label="request()"];
  axios -> proxy [label="开发环境"];
  router -> pinia [label="权限状态"];
  menu -> router [label="getRouters 动态注入"];
  router -> bizViews [label="规划菜单", style=dashed, color="#D97706"];
  bizViews -> bizApi [label="规划调用", style=dashed, color="#D97706"];
  bizApi -> axios [label="复用请求封装", style=dashed, color="#D97706"];

  { rank=same; browser; }
  { rank=same; router; views; api; axios; pinia; }
}
