digraph D4 {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.3, ranksep=0.4, pad=0.2,
         bgcolor="#FFFFFF", fontname="SimHei", fontsize=18, labelloc="t",
         label="FIG-D4  系统开发与部署拓扑（平台中立）"];
  node [shape=box, style="rounded,filled", fontname="SimHei", fontsize=18, margin="0.12,0.08", penwidth=1.3];
  edge [fontname="SimHei", fontsize=14, arrowsize=0.7, penwidth=1.1, color="#52616B"];
  browser [label="浏览器\nChrome / Edge / Firefox", fillcolor="#F4F7FA", color="#7A8FA6"];
  vite [label="Vite 6 :3000\n当前未运行", fillcolor="#DCEEFF", color="#2F6FED", style="rounded,filled,dashed"];
  spring [label="Spring Boot :8080\n当前未运行", fillcolor="#DCEEFF", color="#2F6FED", style="rounded,filled,dashed"];
  db [label="MariaDB :3306\nactive", fillcolor="#DFF3E4", color="#2E7D32"];
  valkey [label="Valkey :6379\nactive", fillcolor="#DFF3E4", color="#2E7D32"];
  web [label="静态资源/反向代理\n（规划）", fillcolor="#EADCF8", color="#6A1B9A", style="rounded,filled,dashed"];
  browser -> vite [label="开发 HTTP", style=dashed];
  vite -> spring [label="/dev-api → :8080", style=dashed];
  spring -> db [label="JDBC"];
  spring -> valkey [label="Lettuce"];
  browser -> web [label="生产静态", style=dashed];
  web -> spring [label="REST/HTTPS（规划）", style=dashed];
  { rank=same; db; valkey; }
}
