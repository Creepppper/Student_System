digraph D4 {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.5, ranksep=0.55, pad=0.25,
         bgcolor="#FFFFFF", fontname="SimHei", fontsize=14, labelloc="t",
         label="FIG-D4  系统开发与部署拓扑图（组件与端口）"];
  node [shape=box, style="rounded,filled", fontname="SimHei", fontsize=13, margin="0.16,0.08", penwidth=1.2];
  edge [fontname="SimHei", fontsize=11, arrowsize=0.7, penwidth=1.1, color="#52616B"];

  subgraph cluster_host {
    label="开发主机（本地）"; fontsize=13; color="#2F6FED"; style="rounded"; bgcolor="#F7FAFF";
    browser [label="浏览器\nChrome / Edge / Firefox", fillcolor="#F4F7FA", color="#7A8FA6"];
    vite [label="Vite 6 开发服务器\n:3000\n当前未运行", fillcolor="#DCEEFF", color="#2F6FED", style="rounded,filled,dashed"];
    spring [label="Spring Boot 3.5.16\n:8080\n当前未运行", fillcolor="#DCEEFF", color="#2F6FED", style="rounded,filled,dashed"];
    mariadb [label="MariaDB 11.8.8\n:3306\nactive（实测）", fillcolor="#DFF3E4", color="#2E7D32"];
    valkey [label="Valkey 9.0.6\n:6379\nPONG（实测）", fillcolor="#DFF3E4", color="#2E7D32"];
  }
  subgraph cluster_planned {
    label="计划中的部署方案（未实现）"; fontsize=12; color="#D97706"; style="rounded"; bgcolor="#FFF7ED";
    web [label="静态 Web 服务器\nfrontend/dist\n（规划）", fillcolor="#FFE7CF", color="#D97706", style="rounded,filled,dashed"];
    reverse [label="反向代理 / HTTPS\n（规划，未选型）", fillcolor="#EADCF8", color="#6A1B9A", style="rounded,filled,dashed"];
  }

  browser -> vite [label="http://localhost:3000\n（当前未启动）", style=dashed];
  vite -> spring [label="/dev-api → :8080\n（开发代理）", style=dashed];
  spring -> mariadb [label="JDBC / MySQL 协议\nstudent_system"];
  spring -> valkey [label="Lettuce\n验证码/LoginUser/缓存"];
  browser -> web [label="生产静态资源", style=dashed];
  web -> reverse [label="HTTPS/反代", style=dashed];
  reverse -> spring [label="REST API\n（规划）", style=dashed];

  { rank=same; browser; vite; spring; }
  { rank=same; mariadb; valkey; }
  { rank=same; web; reverse; }
}
