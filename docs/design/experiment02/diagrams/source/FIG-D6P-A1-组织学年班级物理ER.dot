digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.35, ranksep=0.55, pad=0.2, bgcolor="#FFFFFF", fontname="SimHei", fontsize=13, labelloc="t", label="FIG-D6P-A1  组织/学年/班级物理 ER（规划）"];
  node [shape=plaintext, fontname="SimHei", fontsize=10];
  edge [fontname="SimHei", fontsize=9, arrowsize=0.6, color="#52616B"];
  stu_year [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_year</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">—</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">year_code, year_name, current_slot</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">year_code, year_name, start_date</TD></TR></TABLE>>];
  stu_term [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_term</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">year_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">year_id+term_no, year_id+term_name</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">year_id, term_no, term_name</TD></TR></TABLE>>];
  stu_grade [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_grade</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">—</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">grade_code, grade_name</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">grade_code, grade_name, sort_order</TD></TR></TABLE>>];
  stu_class [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_class</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">year_id, grade_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">year_id+class_code, year_id+class_name</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">year_id, grade_id, class_code</TD></TR></TABLE>>];
  stu_subject [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_subject</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">—</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">subject_code, subject_name</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">subject_code, subject_name, sort_order</TD></TR></TABLE>>];
  stu_term -> stu_year [label="1 : N", dir=none];
  stu_class -> stu_year [label="1 : N", dir=none];
  stu_class -> stu_grade [label="1 : N", dir=none];
  note [shape=note, label="物理模型：PK/FK/UK 来自 P0 设计草稿；\n字段字典见 03-完整数据库字段字典.md。", fillcolor="#F8FAFC", color="#9AA7B4", fontsize=10];
}