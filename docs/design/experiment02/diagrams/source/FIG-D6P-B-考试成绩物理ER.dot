digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.35, ranksep=0.55, pad=0.2, bgcolor="#FFFFFF", fontname="SimHei", fontsize=13, labelloc="t", label="FIG-D6P-B  考试/成绩物理 ER（规划）"];
  node [shape=plaintext, fontname="SimHei", fontsize=10];
  edge [fontname="SimHei", fontsize=9, arrowsize=0.6, color="#52616B"];
  stu_exam [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_exam</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">year_id, term_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">exam_code, year_id+term_id+exam_name</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">year_id, term_id, exam_code</TD></TR></TABLE>>];
  stu_exam_class [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_exam_class</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">exam_id, class_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">exam_id+class_id</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">exam_id, class_id</TD></TR></TABLE>>];
  stu_exam_subject [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_exam_subject</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">exam_id, subject_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">exam_id+subject_id</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">exam_id, subject_id, full_mark</TD></TR></TABLE>>];
  stu_score_task [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_score_task</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">exam_id, class_id, subject_id, first_owner_teacher_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">exam_id+class_id+subject_id</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">exam_id, class_id, subject_id</TD></TR></TABLE>>];
  stu_score [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_score</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">task_id, student_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">task_id+student_id</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">task_id, student_id, score_status</TD></TR></TABLE>>];
  stu_exam_class -> stu_exam [label="1 : N", dir=none];
  stu_exam_subject -> stu_exam [label="1 : N", dir=none];
  stu_score_task -> stu_exam [label="1 : N", dir=none];
  stu_score -> stu_score_task [label="1 : N", dir=none];
  note [shape=note, label="物理模型：PK/FK/UK 来自 P0 设计草稿；\n字段字典见 03-完整数据库字段字典.md。", fillcolor="#F8FAFC", color="#9AA7B4", fontsize=10];
}