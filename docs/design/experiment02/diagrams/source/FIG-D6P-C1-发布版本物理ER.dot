digraph G {
  graph [rankdir=TB, newrank=true, splines=polyline, nodesep=0.35, ranksep=0.55, pad=0.2, bgcolor="#FFFFFF", fontname="SimHei", fontsize=13, labelloc="t", label="FIG-D6P-C1  发布/版本/明细物理 ER（规划）"];
  node [shape=plaintext, fontname="SimHei", fontsize=10];
  edge [fontname="SimHei", fontsize=9, arrowsize=0.6, color="#52616B"];
  stu_publication [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_publication</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">exam_id, class_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">exam_id+class_id</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">exam_id, class_id, publication_status</TD></TR></TABLE>>];
  stu_publication_version [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_publication_version</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">publication_id, based_on_version_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">publication_id+version_no</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">publication_id, version_no, based_on_version_id</TD></TR></TABLE>>];
  stu_publication_version_detail [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="3" COLOR="#D97706"><TR><TD BGCOLOR="#FFE7CF" COLSPAN="2"><B>stu_publication_version_detail</B></TD></TR><TR><TD ALIGN="LEFT">PK</TD><TD ALIGN="LEFT">id INT</TD></TR><TR><TD ALIGN="LEFT">FK</TD><TD ALIGN="LEFT">publication_version_id, student_id, subject_id</TD></TR><TR><TD ALIGN="LEFT">UK</TD><TD ALIGN="LEFT">publication_version_id+student_id+subject_id</TD></TR><TR><TD ALIGN="LEFT">列</TD><TD ALIGN="LEFT">publication_version_id, student_id, subject_id</TD></TR></TABLE>>];
  stu_publication_version -> stu_publication [label="1 : N", dir=none];
  stu_publication_version_detail -> stu_publication_version [label="1 : N", dir=none];
  note [shape=note, label="物理模型：PK/FK/UK 来自 P0 设计草稿；\n字段字典见 03-完整数据库字段字典.md。", fillcolor="#F8FAFC", color="#9AA7B4", fontsize=10];
}