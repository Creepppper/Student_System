digraph FIG02 {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.3", ranksep="0.55",
         fontname="Noto Sans CJK SC", fontsize=11, labelloc=t,
         label="FIG-02 系统 1 层 DFD（P0）\n按主题分组：P2/P3 合并显示，P4/P5/P6/P7 保留编号；局部展开见 FIG-02A/02B；P1 复核见 FIG-02C", dpi=220];
  node [fontname="Noto Sans CJK SC", fontsize=9];
  edge [fontname="Noto Sans CJK SC", fontsize=7.0, color="#546E7A", arrowsize=0.55];

  EO1 [label="EO-01 系统管理员", shape=box, style="rounded,filled", fillcolor="#E3F0FB", color="#2F5D8A", width=1.6];
  EO2 [label="EO-02 教务管理员", shape=box, style="rounded,filled", fillcolor="#E3F0FB", color="#2F5D8A", width=1.6];
