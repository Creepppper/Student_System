  EO4 [label="EO-04 学生", shape=box, style="rounded,filled", fillcolor="#F3E5F5", color="#6A1B9A", width=1.6];

  P1 [label="P1 身份认证与权限", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#B8860B"];
  P23 [label="P2/P3 基础资料与考试配置\n（合并显示）", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#B8860B"];
  P4 [label="P4 成绩录入与提交", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#B8860B"];
  P5 [label="P5 成绩审核与发布", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#B8860B"];
  P6 [label="P6 成绩查询与统计", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#B8860B"];
  P7 [label="P7 业务审计与记录查询", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#B8860B"];

  D1 [label="DS-1 账号与权限", shape=box3d, style="filled", fillcolor="#ECEFF1", color="#607D8B"];
  D2 [label="DS-2 教务基础数据\n（组织/人员/考试）", shape=box3d, style="filled", fillcolor="#ECEFF1", color="#607D8B"];
  D3 [label="DS-3 成绩与发布\n（任务/成绩/发布）", shape=box3d, style="filled", fillcolor="#ECEFF1", color="#607D8B"];
  D4 [label="DS-4 业务审计", shape=box3d, style="filled", fillcolor="#ECEFF1", color="#607D8B"];

  EO1 -> P1 [dir=both, label="登录凭据/认证与配置结果"];
  EO2 -> P1 [dir=both, label="登录/账号绑定/结果"];
  EO3 -> P1 [dir=both, label="登录凭据/认证结果"];
  EO4 -> P1 [dir=both, label="登录凭据/认证结果"];

  EO1 -> P7 [label="系统审计查询"];
