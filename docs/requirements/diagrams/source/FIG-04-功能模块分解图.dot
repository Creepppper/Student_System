digraph FIG04 {
  graph [size="10,10", rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.3", ranksep="0.7",
         fontname="Noto Sans CJK SC", fontsize=11, labelloc=t,
         label="FIG-04 系统功能模块分解图（P0 35 项 / P1 11 项）\n功能树只表示层级；FR 明细见 FIG-04A1～A3、04B", dpi=220];
  node [fontname="Noto Sans CJK SC", fontsize=9, shape=box, style="rounded,filled", fillcolor="#FFF8E7", color="#B8860B", margin="0.08,0.04"];
  edge [color="#8A6D3B", arrowhead=none, arrowsize=0.4];

  SYS [label="高中学生信息与成绩管理系统\nP0 主链路 + P1 扩展", fillcolor="#DCE9F7", color="#2F5D8A", fontsize=12, width=3.0];
  P0 [label="P0 必须交付\n35 项", fillcolor="#FFF3CD", color="#B8860B", fontsize=10, width=1.8];
  P1 [label="P1 扩展\n11 项", fillcolor="#F3E8FF", color="#7B4FA0", fontsize=10, width=1.8, style="rounded,dashed,filled"];
  SYS -> P0; SYS -> P1;

  G_BASE [label="教务基础\n5 个模块", fillcolor="#FFF3CD", fontsize=9.5];
  G_SCORE [label="成绩与审计\n5 个模块", fillcolor="#FFF3CD", fontsize=9.5];
  G_P1 [label="P1 扩展\n4 个模块", fillcolor="#E9D8FD", color="#7B4FA0", fontsize=9.5, style="rounded,dashed,filled"];
  P0 -> G_BASE; P0 -> G_SCORE; P1 -> G_P1;

  M_AUTH [label="MOD-AUTH 认证与权限\nFR-AUTH-001～005"];
  M_ORG  [label="MOD-ORG 组织与学年\nFR-ORG-001～005"];
  M_STU  [label="MOD-STU 学生档案\nFR-STU-001～004"];
  M_TCH  [label="MOD-TCH 班主任与科目\nFR-TCH-001～002"];
  M_EXAM [label="MOD-EXAM 考试管理\nFR-EXAM-001～004"];
  M_SCORE[label="MOD-SCORE 成绩录入与提交\nFR-SCORE-001～005"];
  M_PUB  [label="MOD-PUB 审核与发布\nFR-PUB-001～004"];
  M_QUERY[label="MOD-QUERY 本人成绩查询\nFR-QUERY-001～002"];
  M_STAT [label="MOD-STAT 基础统计\nFR-STAT-001～002"];
  M_AUDIT[label="MOD-AUDIT 业务审计\nFR-AUDIT-001～002"];
  G_BASE -> M_AUTH; G_BASE -> M_ORG; G_BASE -> M_STU; G_BASE -> M_TCH; G_BASE -> M_EXAM;
  G_SCORE -> M_SCORE; G_SCORE -> M_PUB; G_SCORE -> M_QUERY; G_SCORE -> M_STAT; G_SCORE -> M_AUDIT;

  M_REVIEW [label="MOD-REVIEW 成绩复核\nFR-REVIEW-001/002/004/005", fillcolor="#F7F0FF", color="#7B4FA0", style="rounded,dashed,filled"];
  M_IMPORT [label="MOD-IMPORT 导入导出\nFR-IMPORT-001～004", fillcolor="#F7F0FF", color="#7B4FA0", style="rounded,dashed,filled"];
  M_TREND  [label="MOD-TREND 成绩趋势\nFR-TREND-001～002", fillcolor="#F7F0FF", color="#7B4FA0", style="rounded,dashed,filled"];
  M_COMPARE[label="MOD-COMPARE 班级对比\nFR-COMPARE-001", fillcolor="#F7F0FF", color="#7B4FA0", style="rounded,dashed,filled"];
  G_P1 -> M_REVIEW [style=dashed]; G_P1 -> M_IMPORT [style=dashed];
  G_P1 -> M_TREND [style=dashed]; G_P1 -> M_COMPARE [style=dashed];

  NOTE [shape=note, style=filled, fillcolor="#FAFAFA", color="#999999", fontsize=8,
        label="说明：图中为功能模块层级，不是 Maven/项目目录；\lP0 35/P1 11 的完整 FR 展开见 04A1～A3 与 04B。\l不出现任课教师。\l"];
  M_AUDIT -> NOTE [style=dotted, arrowhead=none, color="#999999"];
}
