digraph FIG04A {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.10", ranksep="0.55",
         fontname="Noto Sans CJK SC", fontsize=11, labelloc=t,
         label="FIG-04A P0 功能模块—FR 分解（35 项）\n每个 FR 都是现行有效需求；P1 不在本图", dpi=200];
  node [fontname="Noto Sans CJK SC", fontsize=8.5, shape=box, style="rounded,filled",
        fillcolor="#FFF8E7", color="#B8860B", margin="0.05,0.03", height=0.25];
  edge [fontname="Noto Sans CJK SC", fontsize=7, color="#8A6D3B", arrowsize=0.5];

  ROOT [label="P0\n35 项", shape=box, style="rounded,filled", fillcolor="#FFF3CD", color="#B8860B", fontsize=11, width=1.2];

  M_AUTH [label="MOD-AUTH\n认证与权限", fillcolor="#FFF3CD", fontsize=9];
  M_ORG  [label="MOD-ORG\n组织与学年", fillcolor="#FFF3CD", fontsize=9];
  M_STU  [label="MOD-STU\n学生档案", fillcolor="#FFF3CD", fontsize=9];
  M_TCH  [label="MOD-TCH\n班主任与科目", fillcolor="#FFF3CD", fontsize=9];
  M_EXAM [label="MOD-EXAM\n考试管理", fillcolor="#FFF3CD", fontsize=9];
  M_SCORE[label="MOD-SCORE\n成绩录入与提交", fillcolor="#FFF3CD", fontsize=9];
  M_PUB  [label="MOD-PUB\n审核与发布", fillcolor="#FFF3CD", fontsize=9];
  M_QUERY[label="MOD-QUERY\n本人成绩查询", fillcolor="#FFF3CD", fontsize=9];
  M_STAT [label="MOD-STAT\n基础统计", fillcolor="#FFF3CD", fontsize=9];
  M_AUDIT[label="MOD-AUDIT\n业务审计", fillcolor="#FFF3CD", fontsize=9];

  ROOT -> M_AUTH; ROOT -> M_ORG; ROOT -> M_STU; ROOT -> M_TCH; ROOT -> M_EXAM;
  ROOT -> M_SCORE; ROOT -> M_PUB; ROOT -> M_QUERY; ROOT -> M_STAT; ROOT -> M_AUDIT;

  A1 [label="FR-AUTH-001 登录/登出/验证码"];
  A2 [label="FR-AUTH-002 用户/角色/菜单/按钮权限"];
  A3 [label="FR-AUTH-003 业务角色分配与账号绑定"];
  A4 [label="FR-AUTH-004 业务数据范围过滤"];
  A5 [label="FR-AUTH-005 账号启停与密码重置"];
  M_AUTH -> A1; M_AUTH -> A2; M_AUTH -> A3; M_AUTH -> A4; M_AUTH -> A5;

  O1 [label="FR-ORG-001 学年管理"];
  O2 [label="FR-ORG-002 学期管理"];
  O3 [label="FR-ORG-003 年级管理"];
  O4 [label="FR-ORG-004 班级管理"];
  O5 [label="FR-ORG-005 班主任指派与变更"];
  M_ORG -> O1; M_ORG -> O2; M_ORG -> O3; M_ORG -> O4; M_ORG -> O5;

  S1 [label="FR-STU-001 学生档案维护"];
  S2 [label="FR-STU-002 学生班级归属与变更"];
  S3 [label="FR-STU-003 学生账号开通与关联"];
  S4 [label="FR-STU-004 学生状态管理"];
  M_STU -> S1; M_STU -> S2; M_STU -> S3; M_STU -> S4;

  T1 [label="FR-TCH-001 班主任档案维护"];
  T2 [label="FR-TCH-002 科目维护"];
  M_TCH -> T1; M_TCH -> T2;

  E1 [label="FR-EXAM-001 考试创建与编辑"];
  E2 [label="FR-EXAM-002 考试范围配置"];
  E3 [label="FR-EXAM-003 考试科目与分值配置"];
  E4 [label="FR-EXAM-004 考试状态管理"];
  M_EXAM -> E1; M_EXAM -> E2; M_EXAM -> E3; M_EXAM -> E4;

  C1 [label="FR-SCORE-001 成绩录入任务生成"];
  C2 [label="FR-SCORE-002 成绩录入与暂存"];
  C3 [label="FR-SCORE-003 成绩校验"];
  C4 [label="FR-SCORE-004 成绩提交与退回后重提"];
  C5 [label="FR-SCORE-005 缺考/未录入状态维护"];
  M_SCORE -> C1; M_SCORE -> C2; M_SCORE -> C3; M_SCORE -> C4; M_SCORE -> C5;

  P1 [label="FR-PUB-001 教务审核"];
  P2 [label="FR-PUB-002 班级成绩发布"];
  P3 [label="FR-PUB-003 撤回发布"];
  P4 [label="FR-PUB-004 发布后更正与版本"];
  M_PUB -> P1; M_PUB -> P2; M_PUB -> P3; M_PUB -> P4;

  Q1 [label="FR-QUERY-001 学生查询本人已发布成绩"];
  Q2 [label="FR-QUERY-002 成绩明细/总分/班级排名"];
  M_QUERY -> Q1; M_QUERY -> Q2;

  X1 [label="FR-STAT-001 单场考试班级学科统计"];
  X2 [label="FR-STAT-002 班级学生总分与排名汇总"];
  M_STAT -> X1; M_STAT -> X2;

  U1 [label="FR-AUDIT-001 成绩业务变更记录"];
  U2 [label="FR-AUDIT-002 发布与撤回记录"];
  M_AUDIT -> U1; M_AUDIT -> U2;
}
