digraph FIG04B {
  graph [rankdir=LR, bgcolor="white", pad="0.25", nodesep="0.12", ranksep="0.55",
         fontname="Noto Sans CJK SC", fontsize=11, labelloc=t,
         label="FIG-04B P1 功能模块—FR 分解（11 项）\nP1 不进入 P0 退出条件；不得用 P1 替代 P0 交付", dpi=200];
  node [fontname="Noto Sans CJK SC", fontsize=9, shape=box, style="rounded,dashed,filled",
        fillcolor="#F7F0FF", color="#7B4FA0", margin="0.06,0.04", height=0.28];
  edge [fontname="Noto Sans CJK SC", fontsize=7.5, color="#7B4FA0", arrowsize=0.5];

  ROOT [label="P1\n11 项", shape=box, style="rounded,dashed,filled", fillcolor="#E9D8FD", color="#7B4FA0", fontsize=11, width=1.2];

  M_REVIEW [label="MOD-REVIEW\n成绩复核", fillcolor="#E9D8FD", fontsize=9.5];
  M_IMPORT [label="MOD-IMPORT\n导入导出", fillcolor="#E9D8FD", fontsize=9.5];
  M_TREND  [label="MOD-TREND\n成绩趋势", fillcolor="#E9D8FD", fontsize=9.5];
  M_COMPARE[label="MOD-COMPARE\n班级对比", fillcolor="#E9D8FD", fontsize=9.5];
  ROOT -> M_REVIEW [style=dashed]; ROOT -> M_IMPORT [style=dashed];
  ROOT -> M_TREND [style=dashed]; ROOT -> M_COMPARE [style=dashed];

  R1 [label="FR-REVIEW-001 学生提交复核申请"];
  R2 [label="FR-REVIEW-002 班主任受理/驳回与核查"];
  R4 [label="FR-REVIEW-004 复核结论确认"];
  R5 [label="FR-REVIEW-005 学生查看复核结果"];
  M_REVIEW -> R1 [style=dashed]; M_REVIEW -> R2 [style=dashed];
  M_REVIEW -> R4 [style=dashed]; M_REVIEW -> R5 [style=dashed];

  I1 [label="FR-IMPORT-001 导入模板下载"];
  I2 [label="FR-IMPORT-002 导入预检与错误反馈"];
  I3 [label="FR-IMPORT-003 事务导入"];
  I4 [label="FR-IMPORT-004 成绩导出"];
  M_IMPORT -> I1 [style=dashed]; M_IMPORT -> I2 [style=dashed];
  M_IMPORT -> I3 [style=dashed]; M_IMPORT -> I4 [style=dashed];

  T1 [label="FR-TREND-001 学生个人成绩趋势"];
  T2 [label="FR-TREND-002 班级/学科成绩趋势"];
  M_TREND -> T1 [style=dashed]; M_TREND -> T2 [style=dashed];

  C1 [label="FR-COMPARE-001 多班级对比分析"];
  M_COMPARE -> C1 [style=dashed];

  NOTE [shape=note, style=filled, fillcolor="#FAFAFA", fontsize=8.5,
        label="P1 边界：不改变 P0 状态机、权限和成绩真值；\l复核/导入/趋势/对比均在 P0 稳定后实现。\l"];
  M_COMPARE -> NOTE [style=dotted, arrowhead=none];
}
