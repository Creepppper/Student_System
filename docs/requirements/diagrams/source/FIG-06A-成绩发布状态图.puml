@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam dpi 200
skinparam shadowing false
skinparam stateFontSize 10
skinparam state {
  BackgroundColor #FFF8E7
  BorderColor #B8860B
}
title FIG-06A 班级发布状态图（PUB_*）\n发布/撤回/重发/受控更正；撤回后学生不可见，数据保留

state "PUB_UNPUBLISHED\n未发布" as U
state "PUB_PUBLISHED\n已发布" as P
state "PUB_WITHDRAWN\n已撤回" as W

[*] --> U
U --> P : 教务 / 发布\n[所有适用任务 TASK_APPROVED；\n无未录入；至少1科]
P --> W : 教务 / 撤回\n[原因]
W --> P : 教务 / 重新发布\n[APPROVED；版本+1]
P --> P : 教务 / 受控更正\n[原因；前后值；生成新版本；\n旧版本不可变；重算总分/排名]
legend bottom
  发布唯一 (考试,班级)，有版本；撤回/更正/重发版本递增；
  受控更正保持 PUB_PUBLISHED，生成新的不可变版本；
  保留原值/新值/原因/操作人/时间，不允许直接覆盖历史；
  撤回必须填原因；重发要求全部任务仍 APPROVED；所有动作写审计。
endlegend
@enduml
