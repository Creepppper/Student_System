@startuml
skinparam defaultFontName "Noto Sans CJK SC"
skinparam dpi 180
skinparam shadowing false
skinparam activityFontSize 8
skinparam activityDiamondFontSize 8
skinparam swimlaneTitleFontSize 10
skinparam activity {
  BackgroundColor #FFF8E7
  BorderColor #B8860B
}
skinparam swimlane {
  BorderColor #546E7A
}
title FIG-07 成绩管理正常主流程（P0）\n前置：考试已配置；正常路径要求数据合法、无未录入；异常分别转 07A/07B/07C

|教务管理员|
start
:创建考试、配置范围/科目/满分线;
:开放考试;
|系统|
:按考试×班级×科目生成任务;
:创建待录入任务;
|班主任|
:录入/暂存本班全科成绩;
|系统|
:校验字段、步长、完整性;
if (校验通过？) then (通过)
  |班主任|
  :提交成绩任务;
  |系统|
  :TASK_SUBMITTED;
  :通知教务审核;
  |教务管理员|
  :逐任务审核;
  if (审核通过？) then (通过)
    |系统|
    :TASK_APPROVED;
    |教务管理员|
    :按考试×班级发布;
    |系统|
    :PUB_PUBLISHED（版本1）;
    :数据权限检查;
    |学生|
    :查询本人已发布成绩;
  else (退回)
    |系统|
    :调用「07B 审核退回/重提」;
    detach
  endif
else (校验不通过)
  |系统|
  :调用「07A 校验与补录」;
  detach
endif
stop
@enduml
