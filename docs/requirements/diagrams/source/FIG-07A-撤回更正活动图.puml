@startuml
scale 0.9
skinparam defaultFontName "Noto Sans CJK SC"
skinparam dpi 180
skinparam shadowing false
skinparam activityFontSize 8
skinparam activityDiamondFontSize 8
skinparam swimlaneTitleFontSize 10
skinparam activity {
  BackgroundColor #FFF8E7
  BorderColor #B8860B
}
skinparam swimlane {
  BorderColor #546E7A
}
title FIG-07A 异常、退回与撤回活动图（P0 异常分支）\n非法数据/未录入阻止提交；退回重提；撤回后学生不可见

|班主任|
start
:进入成绩异常处理;
if (数据非法？) then (是)
  :提示字段/步长错误;
  :修正数据;
  :重新校验;
else (否)
  if (存在未录入？) then (是)
    :阻止提交并列出学生;
    :补充录入;
    :重新校验;
  else (否)
    :提交成绩任务;
    |教务管理员|
    :审核任务;
    if (审核通过？) then (否)
      |教务管理员|
      :退回并填写原因;
      |班主任|
      :修改后重新提交;
      |教务管理员|
      :重新审核;
    else (是)
      |教务管理员|
      :按班发布;
    endif
    |学生|
    :查询本人已发布成绩;
    if (教务撤回？) then (是)
      |教务管理员|
      :撤回并填写原因;
      |学生|
      :成绩不可见，数据保留;
    else (否)
      |学生|
      :保持可见;
    endif
  endif
endif
stop
@enduml
