digraph FIG09 {
  graph [size="15,10", rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.18", ranksep="0.55", newrank=true,
         fontname="Noto Sans CJK SC", fontsize=11, labelloc=t,
         label="FIG-09 业务概念 ER 图总览（v1.2；17 个 DR + 班主任任职关联实体）\n完整基数/唯一约束见 FIG-09A/09B/09C；P1 复核以虚线标注", dpi=220];
  node [fontname="Noto Sans CJK SC", fontsize=8.5, shape=box, style="rounded,filled",
        fillcolor="#F5F7FA", color="#546E7A", margin="0.05,0.03", width=2.15, height=0.62];
  edge [fontname="Noto Sans CJK SC", fontsize=7.2, color="#546E7A", arrowsize=0.55];

  subgraph cluster_org {
    label="组织、人员与任职"; fontsize=9; fontcolor="#2F5D8A"; style="rounded,dashed"; color="#90CAF9";
    YEAR [label="ENT-01 学年\nDR-ORG-001\nPK 学年编码"];
    TERM [label="ENT-02 学期\nDR-ORG-002\nPK 学期ID"];
    GRADE [label="ENT-03 年级\nDR-ORG-003\nPK 年级ID"];
    CLASS [label="ENT-04 班级\nDR-ORG-004\nPK 班级ID"];
    STUD [label="ENT-05 学生\nDR-STU-001\nPK 学生ID"];
    SCLASS [label="ENT-06 学生班级归属\nDR-STU-002（关联实体）\n学年+学生唯一有效"];
    HEAD [label="ENT-07 班主任\nDR-TCH-001\nPK 班主任ID"];
    ASSIGN [label="ENT-08 班主任任职\n（历史化关联实体）\n班级+班主任+起止", style="rounded,filled,dashed"];
  }

  subgraph cluster_exam {
    label="考试与科目"; fontsize=9; fontcolor="#7A4B00"; style="rounded,dashed"; color="#FFCC80";
    SUBJ [label="ENT-09 科目\nDR-TCH-002\nPK 科目ID"];
    EXAM [label="ENT-10 考试\nDR-EXAM-001\nPK 考试ID"];
    ECLASS [label="ENT-11 考试班级范围\nDR-EXAM-002（关联实体）\n考试+班级唯一"];
    ESUBJ [label="ENT-12 考试科目\nDR-EXAM-003（关联实体）\n考试+科目唯一"];
  }

  subgraph cluster_score {
    label="成绩、发布与审计"; fontsize=9; fontcolor="#2E7D32"; style="rounded,dashed"; color="#A5D6A7";
    TASK [label="ENT-13 成绩任务\nDR-SCORE-001\n考试+班级+科目唯一"];
    SCORE [label="ENT-14 成绩记录\nDR-SCORE-002\n任务+学生唯一"];
    PUB [label="ENT-15 班级发布\nDR-PUB-001\n考试+班级唯一；版本"];
    AUDIT [label="ENT-16 业务变更记录\nDR-AUDIT-001\n事件日志，多态引用"];
  }

  subgraph cluster_acct {
    label="账号与 P1 复核"; fontsize=9; fontcolor="#6A1B9A"; style="rounded,dashed"; color="#CE93D8";
    ACCT [label="ENT-17 账号-档案关联\nDR-AUTH-001（关联实体）\n账号与档案 1:1"];
    REVIEW [label="ENT-18 复核申请（P1）\nDR-REVIEW-001\n详见 FIG-09C", style="rounded,dashed,filled", fillcolor="#F3E5F5"];
  }

  YEAR -> TERM [label="1:N"];
  YEAR -> CLASS;
  GRADE -> CLASS;
  TERM -> EXAM [label="1:N"];
  CLASS -> SCLASS;
  STUD -> SCLASS;
  YEAR -> SCLASS;
  HEAD -> ASSIGN;
  CLASS -> ASSIGN;
  ASSIGN -> CLASS [style=dashed, color="#2F5D8A"];

  SUBJ -> ESUBJ [label="1:N"];
  EXAM -> ESUBJ [label="1:N"];
  EXAM -> ECLASS [label="1:N"];
  CLASS -> ECLASS;

  ECLASS -> TASK;
  ESUBJ -> TASK;
  HEAD -> TASK;
  TASK -> SCORE;
  STUD -> SCORE;
  EXAM -> PUB;
  CLASS -> PUB;

  ACCT -> STUD [label="0..1:1", style=dashed, color="#6A1B9A"];
  ACCT -> HEAD [label="0..1:1", style=dashed, color="#6A1B9A"];



  NOTE [shape=note, style=filled, fillcolor="#FAFAFA", color="#999999", fontsize=8,
        label="约束：\l• 每班同一时刻最多 1 名有效班主任；1 名班主任可负责多个班。\l• 成绩任务唯一考试×班级×科目；第一责任人为班主任快照。\l• 成绩记录唯一任务×学生；发布唯一考试×班级，版本递增。\l• 学生班级归属按学年保留历史；班主任任职保留起止历史。\l• 审计为多态事件，细见 FIG-09B；P1 复核细见 FIG-09C。\l"];
  AUDIT -> NOTE [style=dotted, arrowhead=none, color="#999999"];
}
