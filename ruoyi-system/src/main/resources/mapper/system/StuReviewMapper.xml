<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.StuReviewMapper">
    
    <resultMap type="StuReview" id="StuReviewResult">
        <result property="id"    column="id"    />
        <result property="studentId"    column="student_id"    />
        <result property="examId"    column="exam_id"    />
        <result property="subject"    column="subject"    />
        <result property="reason"    column="reason"    />
        <result property="status"    column="status"    />
        <result property="reply"    column="reply"    />
        <result property="createTime"    column="create_time"    />
        <result property="updateTime"    column="update_time"    />
    </resultMap>

    <sql id="selectStuReviewVo">
        select id, student_id, exam_id, subject, reason, status, reply, create_time, update_time from stu_review
    </sql>

    <select id="selectStuReviewList" parameterType="StuReview" resultMap="StuReviewResult">
        <include refid="selectStuReviewVo"/>
        <where>  
            <if test="studentId != null "> and student_id = #{studentId}</if>
            <if test="examId != null "> and exam_id = #{examId}</if>
            <if test="subject != null  and subject != ''"> and subject = #{subject}</if>
            <if test="reason != null  and reason != ''"> and reason = #{reason}</if>
            <if test="status != null  and status != ''"> and status = #{status}</if>
            <if test="reply != null  and reply != ''"> and reply = #{reply}</if>
        </where>
    </select>
    
    <select id="selectStuReviewById" parameterType="Long" resultMap="StuReviewResult">
        <include refid="selectStuReviewVo"/>
        where id = #{id}
    </select>

    <insert id="insertStuReview" parameterType="StuReview" useGeneratedKeys="true" keyProperty="id">
        insert into stu_review
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="studentId != null">student_id,</if>
            <if test="examId != null">exam_id,</if>
            <if test="subject != null and subject != ''">subject,</if>
            <if test="reason != null and reason != ''">reason,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="reply != null">reply,</if>
            <if test="createTime != null">create_time,</if>
            <if test="updateTime != null">update_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="studentId != null">#{studentId},</if>
            <if test="examId != null">#{examId},</if>
            <if test="subject != null and subject != ''">#{subject},</if>
            <if test="reason != null and reason != ''">#{reason},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="reply != null">#{reply},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateStuReview" parameterType="StuReview">
        update stu_review
        <trim prefix="SET" suffixOverrides=",">
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="examId != null">exam_id = #{examId},</if>
            <if test="subject != null and subject != ''">subject = #{subject},</if>
            <if test="reason != null and reason != ''">reason = #{reason},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="reply != null">reply = #{reply},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteStuReviewById" parameterType="Long">
        delete from stu_review where id = #{id}
    </delete>

    <delete id="deleteStuReviewByIds" parameterType="String">
        delete from stu_review where id in 
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>